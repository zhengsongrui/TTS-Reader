// 阅读页文本纯函数

// 按句号/问号/感叹号切分句子（引号内不切分）；
// 换行符左右为文字（非标点符号）视为文本错误直接去掉换行符，否则作为切分标记
export function formatContent(text: string, title: string): string[] {
	const body = text.replace(title, '').replace(/\s+/g, '').replace(/[*＊]/g, '')
	const result: string[] = []
	let current = ''
	let quoteDepth = 0
	// 先去掉所有空白符号，再在句首补上两个全角空格占位符
	const pushSentence = (s: string) => result.push('　　' + s)
	// 是否为文字（非标点符号）：中英文标点之外均视为文字
	const isText = (c: string): boolean => {
		if (c.length == 0) return false
		const code = c.charCodeAt(0) ?? 0
		// ASCII 标点符号区（! " # $ % & ' ( ) * + , - . / 等）
		if ((code >= 0x21 && code <= 0x2f) ||
			(code >= 0x3a && code <= 0x40) ||
			(code >= 0x5b && code <= 0x60) ||
			(code >= 0x7b && code <= 0x7e)) {
			return false
		}
		// 常见中文标点
		return '，。？！、；：（）《》〈〉【】—…·'.indexOf(c) < 0
	}
	for (let i = 0; i < body.length; i++) {
		const ch = body.charAt(i)
		if (ch == '\r' || ch == '\n') {
			// 连续换行（如 \r\n）视为一个整体
			let j = i
			while (j < body.length && (body.charAt(j) == '\r' || body.charAt(j) == '\n')) {
				j++
			}
			const prev = i > 0 ? body.charAt(i - 1) : ''
			// 向后跳过换行后的空白字符，再判断是否为文字（如 "自己\r\n\r\n    身前"）
			let k = j
			while (k < body.length && (body.charAt(k) == ' ' || body.charAt(k) == '\t')) {
				k++
			}
			const next = k < body.length ? body.charAt(k) : ''
			// 换行前后均为文字（非标点符号）：视为文本错误直接去掉换行符，不切分
			if (isText(prev) && isText(next)) {
				i = j - 1
				continue
			}
			// 否则作为切分标记
			if (current.length > 0) {
				pushSentence(current)
				current = ''
			}
			i = j - 1
			continue
		}
		current += ch
		if (ch == '“' || ch == '‘' || ch == '「' || ch == '『') {
			quoteDepth++
		} else if (ch == '”' || ch == '’' || ch == '」' || ch == '』') {
			if (quoteDepth > 0) {
				quoteDepth--
			}
		} else if (ch == '。' || ch == '？' || ch == '！') {
			if (quoteDepth == 0) {
				pushSentence(current)
				current = ''
			}
		}
	}
	if (current.length > 0) {
		pushSentence(current)
	}
	return result
}

// 解析 '章节_句子' key 为 [章节索引, 句子索引]
export function parseSentence(key: string): number[] {
	const idx = key.indexOf('_')
	return [parseInt(key.substring(0, idx)), parseInt(key.substring(idx + 1))]
}

// 句子样式：active 高亮 + bookmarked 下划线
export function sentenceClass(activeSentence: string, bookmarkKeys: string[], toSentence: string): string {
	let cls = activeSentence == toSentence ? 'sentence active' : 'sentence'
	if (bookmarkKeys.indexOf(toSentence) >= 0) {
		cls += ' bookmarked'
	}
	return cls
}
