<template>
	<view class="content-root">
		<!-- 背景图：全宽竖向拼接，绝对定位铺在滚动容器下层，按滚动百分比上移 -->
		<view class="image-view" :style="imageViewStyle">
			<image class="bg-image" v-for="(img, i) in bgImages" :key="i" :src="img" mode="widthFix" @load="onImageLoad" />
		</view>
		<scroll-view class="content-wrap" scroll-y="true" :scroll-into-view="scrollIntoViewId" @scroll="onScroll">
			<view class="chapter" v-if="chapters.length > 0" :style="chapterStyle">
				<text class="chapter-title">{{ chapters[currentIndex].title }}</text>
				<view class="content">
					<text
						v-for="(item, index) in content"
						:key="index"
						class="sentence"
						:class="sentenceClassFor(activeSentence, bookmarkKeys, currentIndex + '_' + index)"
						:style="sentenceStyle"
						:id="'c' + currentIndex + '_s' + index"
						@click="onSentenceClick(currentIndex + '_' + index)">
						{{ item }}
					</text>
				</view>
			</view>
			<view class="empty" v-else>
				<text class="empty-text">未解析到章节</text>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { watch, nextTick, computed } from 'vue'
	import type { Chapter } from '../../common/models'
	import { sentenceClass } from '../../common/text'
	import { hexToRgba } from '../../common/reader-setting'

	const props = defineProps<{
		chapters: Chapter[]
		currentIndex: number
		content: string[]
		activeSentence: string
		bookmarkKeys: string[]
		scrollIntoViewId: string
		isListenMode:boolean
		// 阅读设置：正文字号（rpx）、句间距（rpx）、章节背景色/透明度、背景图路径列表
		sentenceFontSize: number
		sentenceMargin: number
		chapterBg: string
		chapterBgAlpha: number
		bgImages: string[]
	}>()

	const emit = defineEmits<{
		(e: 'sentenceClick', toSentence: string): void
		(e: 'scrollTop', idx: number): void
	}>()

	// 句子相对内容顶部的偏移，用于反推顶部句子
	let sentenceOffsets: number[] = []

	// 背景图视差状态：视窗高度 / 背景图总高 / 当前上移量（单位 px）
	const viewportHeight = ref(0)
	const imageTotalHeight = ref(0)
	const bgOffset = ref(0)

	// 正文渲染后缓存各句子偏移（此时滚动位置为 0）
	const refreshSentenceTops = () => {
		uni.createSelectorQuery()
			.select('.content-wrap').boundingClientRect()
			.selectAll('.sentence').boundingClientRect()
			.exec((ret) => {
				const sw = ret[0] as NodeInfo
				const sentences = ret[1] as NodeInfo[]
				sentenceOffsets = sentences.map(s => (s.top ?? 0) - (sw.top ?? 0))
			})
	}

	// 测量视窗高度与背景图总高（px），背景图上移量基于此计算
	const measureBgSizes = () => {
		uni.createSelectorQuery()
			.select('.content-wrap').boundingClientRect()
			.select('.image-view').boundingClientRect()
			.exec((ret) => {
				const wrap = ret[0] as NodeInfo
				const imgView = ret[1] as NodeInfo
				viewportHeight.value = wrap?.height ?? 0
				imageTotalHeight.value = imgView?.height ?? 0
			})
	}

	// 背景图加载完成后重测总高（widthFix 下高度异步确定）
	const onImageLoad = () => {
		nextTick(() => {
			measureBgSizes()
		})
	}

	// 句子样式：模板中调用本地包装函数，避免直接引用导入函数
	const sentenceClassFor = (activeSentence: string, bookmarkKeys: string[], toSentence: string): string =>
		sentenceClass(activeSentence, bookmarkKeys, toSentence)

	// 内容变化后重测句子偏移
	const contentKey = computed(() => props.currentIndex + '_' + props.content.length)
	watch(contentKey, () => {
		// 章节/内容变化：背景图回到初始位置，并重新测量尺寸
		bgOffset.value = 0
		nextTick(() => {
			refreshSentenceTops()
			measureBgSizes()
		})
	})

	// 背景图列表变化：重置偏移并重新测量总高
	// UTS 不支持 watch 直接监听返回数组的 getter（报 Return type mismatch），
	// 按项目惯例用 computed 包装 prop 并显式标注返回类型后再监听
	const bgImagesRef = computed<string[]>(() => props.bgImages)
	watch(bgImagesRef, () => {
		bgOffset.value = 0
		nextTick(() => {
			measureBgSizes()
		})
	})

	// 章节背景动态样式：背景色按透明度合成 rgba（uvue :style 绑定 Map<string,string>）
	const chapterStyle = computed<Map<string, string>>(() => {
		const m = new Map<string, string>()
		m.set('background-color', hexToRgba(props.chapterBg, props.chapterBgAlpha))
		return m
	})
	// 句子动态样式：字号 + 下边距
	const sentenceStyle = computed<Map<string, string>>(() => {
		const m = new Map<string, string>()
		m.set('font-size', props.sentenceFontSize + 'rpx')
		m.set('margin-bottom', props.sentenceMargin + 'rpx')
		return m
	})
	// 背景图动态样式：超出视窗部分按滚动百分比向上移动
	const imageViewStyle = computed<Map<string, string>>(() => {
		const m = new Map<string, string>()
		m.set('top', '-' + bgOffset.value + 'px')
		return m
	})

	// 点击句子：抛出事件由页面处理高亮与书签
	const onSentenceClick = (toSentence: string) => emit('sentenceClick', toSentence)

	// 滚动时反推顶部句子索引并抛出，同时按可滚动距离百分比上移背景图
	const onScroll = (e: UniScrollEvent) => {
		const top = e.detail.scrollTop
		let idx = 0
		for (let i = sentenceOffsets.length - 1; i >= 0; i--) {
			const off = sentenceOffsets[i]
			if (off >= 0 && off <= top) {
				idx = i
				break
			}
		}
		emit('scrollTop', idx)

		// 背景图视差：percentage = 已滚动距离 / 可滚动距离，背景按超出量等比上移
		const scrollHeight = e.detail.scrollHeight
		const maxScroll = scrollHeight - viewportHeight.value
		const percentage = maxScroll > 0 ? top / maxScroll : 0
		const exceed = imageTotalHeight.value - viewportHeight.value
		bgOffset.value = exceed > 0 ? exceed * percentage : 0
	}
</script>

<style lang="scss">
	.content-root {
		flex: 1;
		position: relative;

		// 背景图：绝对定位铺在滚动容器下层，按滚动百分比上移（视差）
		.image-view {
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			z-index: 1;
			// 触摸穿透：背景层不拦截触摸事件，保证正文可正常滚动
			pointer-events: none;

			// 背景图：全宽、按原始宽高比竖向拼接
			.bg-image {
				width: 100%;
			}
		}

		// 滚动容器：覆盖在背景层之上，正文始终可见、可滚动
		.content-wrap {
			flex: 1;
			position: relative;
			z-index: 2;
			background-color: rgba(0, 0, 0, 0);

			.chapter {
				padding: 32rpx;
				position: relative;
				z-index: 99;
				.chapter-title {
					width: 100%;
					font-size: 40rpx;
					font-weight: bold;
					color: #333333;
					text-align: center;
					margin-bottom: 24rpx;
				}

				.content {
					width: 100%;

					.sentence {
						// uvue 不支持 display:inline，直接作为 flex 子项按内容宽度横向排列
						font-size: 32rpx;
						line-height: 1.8;
						color: #333333;
					}

					.sentence.active {
						color: #c99a3a;
						background-color: #f5e8c8;
					}

					.sentence.bookmarked {
						text-decoration-line: underline;
					}
				}
			}
		}
	}

	.empty {
		flex: 1;
		align-items: center;
		justify-content: center;

		.empty-text {
			font-size: 30rpx;
			color: #999999;
		}
	}
</style>
