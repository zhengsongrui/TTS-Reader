// 书签逻辑：当前高亮句子、书签状态、增删查
import { ref } from 'vue'
import type { Bookmark } from '../common/models'
import { addBookmark, removeBookmark, getBookmarks, isBookmarked } from '../common/db'
import { parseSentence } from '../common/text'

export class BookmarkState {
	// 当前高亮句子（'' 表示无）
	activeSentence = ref('')
	// 当前句子是否已加书签
	bookmarked = ref(false)
	// 书签列表
	bookmarks = ref<Bookmark[]>([])
	// 该书全部已加书签句子 key 数组（章节_句子），用于正文下划线标识
	bookmarkKeys = ref<string[]>([])
	// 内部依赖：bookId 与取当前句子文本的回调
	bookId = 0
	getContent: () => string[] = () => []

	// 从数据库加载该书全部书签 key
	loadKeys(): void {
		this.bookmarkKeys.value = getBookmarks(this.bookId).map(b => b.chapterIndex + '_' + b.sentenceIndex)
	}

	// 点击句子：高亮 + 刷新书签状态
	handleSentenceClick(toSentence: string): void {
		this.activeSentence.value = this.activeSentence.value == toSentence ? '' : toSentence
		const parts = parseSentence(toSentence)
		this.bookmarked.value = isBookmarked(this.bookId, parts[0], parts[1])
	}

	// 添加/删除书签
	toggleBookmark(): void {
		const parts = parseSentence(this.activeSentence.value)
		if (this.bookmarked.value) {
			removeBookmark(this.bookId, parts[0], parts[1])
			this.bookmarked.value = false
			this.bookmarkKeys.value = this.bookmarkKeys.value.filter(k => k != this.activeSentence.value)
			uni.showToast({ title: '已删除书签' })
		} else {
			addBookmark(this.bookId, parts[0], parts[1], parts[1] < this.getContent().length ? this.getContent()[parts[1]] : '')
			this.bookmarked.value = true
			this.bookmarkKeys.value.push(this.activeSentence.value)
			uni.showToast({ title: '已添加书签' })
		}
	}

	// 重新加载该书全部书签（侧边栏打开时）
	refresh(): void {
		this.bookmarks.value = getBookmarks(this.bookId)
	}

	// 书签跳转：设置高亮与书签状态
	highlight(chapterIndex: number, sentenceIndex: number): void {
		this.activeSentence.value = chapterIndex + '_' + sentenceIndex
		this.bookmarked.value = true
	}

	// 清空当前高亮
	clearActive(): void {
		this.activeSentence.value = ''
	}

	// 初始化：注入 bookId 与取句子文本的回调
	init(bid: number, getter: () => string[]): void {
		this.bookId = bid
		this.getContent = getter
	}
}
