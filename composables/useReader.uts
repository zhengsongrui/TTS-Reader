// 阅读核心逻辑：章节状态、加载、切换、进度保存
import { ref, nextTick } from 'vue'
import type { Chapter } from '../common/models'
import { getBookInfo, loadChapters, saveReadingProgress, getReadingProgress } from '../common/db'
import { readChapter } from '../common/reader'
import { formatContent } from '../common/text'

export class Reader {
	// 章节状态
	chapters = ref<Chapter[]>([])
	currentIndex = ref(0)
	content = ref<string[]>([])
	scrollIntoViewId = ref('')
	encoding = ref('UTF-8')
	// 内部状态
	filePath = ''
	bookId = 0
	lastSentence = 0
	saveTimer: number | null = null

	// 加载章节（后台读文件+解码，正文渲染后按需恢复句子位置）
	loadChapter(index: number, restoreSentence: number): void {
		if (index < 0 || index >= this.chapters.value.length) return
		this.currentIndex.value = index
		this.content.value = []
		this.scrollIntoViewId.value = ''
		const self = this
		UTSAndroid.getDispatcher('io').async(function(_) {
			try {
				let ch = self.chapters.value[index]
				let text = readChapter(self.filePath, ch.startByte, ch.endByte, self.encoding.value)
				UTSAndroid.getDispatcher('main').async(function(_) {
					self.content.value = formatContent(text, self.chapters.value[self.currentIndex.value]?.title ?? '')
					nextTick(() => {
						if (restoreSentence >= 0 && restoreSentence < self.content.value.length) {
							self.scrollIntoViewId.value = 'c' + self.currentIndex.value + '_s' + restoreSentence
						}
					})
				}, null)
			} catch (e) {
				console.error('read chapter error', e)
				UTSAndroid.getDispatcher('main').async(function(_) {
					uni.showToast({ title: '章节读取失败' })
				}, null)
			}
		}, null)
	}

	// 切章并保存新章节（从顶部开始）
	switchChapter(idx: number): void {
		if (idx < 0 || idx >= this.chapters.value.length) return
		this.loadChapter(idx, -1)
		saveReadingProgress(this.bookId, idx, 0)
	}

	// 滚动时接收正文组件反推的顶部句子索引，防抖保存进度
	onScrollTop(idx: number): void {
		this.lastSentence = idx
		if (this.saveTimer == null) {
			this.saveTimer = setTimeout(() => {
				this.saveTimer = null
				saveReadingProgress(this.bookId, this.currentIndex.value, this.lastSentence)
			}, 500)
		}
	}

	// 初始化：加载书籍信息、章节、上次进度
	init(bid: number): void {
		this.bookId = bid
		let info = getBookInfo(this.bookId)
		this.encoding.value = info.encoding
		this.filePath = info.filePath
		this.chapters.value = loadChapters(this.bookId)
		if (this.chapters.value.length > 0) {
			const progress = getReadingProgress(this.bookId)
			if (progress != null && progress.lastChapterIndex < this.chapters.value.length) {
				this.loadChapter(progress.lastChapterIndex, progress.lastSentenceIndex)
			} else {
				this.loadChapter(0, -1)
			}
		}
	}

	// 退出时保存最终阅读位置
	saveProgress(): void {
		if (this.chapters.value.length > 0) {
			saveReadingProgress(this.bookId, this.currentIndex.value, this.lastSentence)
		}
	}

	prevChapter(): void {
		this.switchChapter(this.currentIndex.value - 1)
	}

	nextChapter(): void {
		this.switchChapter(this.currentIndex.value + 1)
	}
}
