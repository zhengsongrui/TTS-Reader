<template>
	<view class="page">
		<!-- 章节正文 -->
		<ReaderContent
			:chapters="chapters"
			:currentIndex="currentIndex"
			:content="content"
			:activeSentence="activeSentence"
			:bookmarkKeys="bookmarkKeys"
			:scrollIntoViewId="scrollIntoViewId"
			@sentenceClick="onSentenceClick"
			@scrollTop="handleScrollTop" />

		<!-- 底部翻页 -->
		<ReaderFooter
			:visible="chapters.length > 0"
			:currentIndex="currentIndex"
			:total="chapters.length"
			@prev="prevChapter"
			@next="nextChapter" />

		<!-- 底部操作栏（无遮罩） -->
		<ReaderBottomBar
			:visible="activeSentence !== ''"
			:bookmarked="bookmarked"
			@listen="onListen"
			@toggleBookmark="toggleBookmark"
			@more="openSidebar" />

		<!-- 侧边栏 -->
		<ReaderSidebar
			:visible="sidebarVisible"
			:items="sidebarItems"
			:expanded="sidebarExpanded"
			:chapters="chapters"
			:bookmarks="bookmarks"
			:currentIndex="currentIndex"
			@close="closeSidebar"
			@itemClick="onSidebarItemClick"
			@goChapter="goChapter"
			@goBookmark="goBookmark" />
	</view>
</template>

<script setup lang="uts">
	import { Reader } from '../../composables/useReader'
	import { BookmarkState } from '../../composables/useBookmark'
	import { Sidebar } from '../../composables/useSidebar'
	import type { Bookmark } from '../../common/models'
	import ReaderContent from '../../components/reader/ReaderContent.uvue'
	import ReaderFooter from '../../components/reader/ReaderFooter.uvue'
	import ReaderBottomBar from '../../components/reader/ReaderBottomBar.uvue'
	import ReaderSidebar from '../../components/reader/ReaderSidebar.uvue'

	const reader = new Reader()
	const bookmark = new BookmarkState()
	const sidebar = new Sidebar()

	// 阅读核心状态
	const chapters = reader.chapters
	const currentIndex = reader.currentIndex
	const content = reader.content
	const scrollIntoViewId = reader.scrollIntoViewId
	// 书签状态
	const activeSentence = bookmark.activeSentence
	const bookmarked = bookmark.bookmarked
	const bookmarks = bookmark.bookmarks
	const bookmarkKeys = bookmark.bookmarkKeys
	// 侧边栏状态
	const sidebarVisible = sidebar.visible
	const sidebarExpanded = sidebar.expanded
	const sidebarItems = sidebar.items

	// 正文事件
	const onSentenceClick = (toSentence: string) => bookmark.handleSentenceClick(toSentence)
	const handleScrollTop = (idx: number) => reader.onScrollTop(idx)

	// 翻页
	const prevChapter = () => reader.prevChapter()
	const nextChapter = () => reader.nextChapter()

	// 听书占位（暂不实现）
	const onListen = () => {
		uni.showToast({ title: '听书功能暂未开放' })
	}

	// 底部操作栏
	const toggleBookmark = () => bookmark.toggleBookmark()
	const openSidebar = () => {
		bookmark.refresh()
		bookmark.clearActive()
		sidebar.open()
	}

	// 侧边栏
	const closeSidebar = () => sidebar.close()
	const onSidebarItemClick = (value: string) => sidebar.onItemClick(value)
	const goChapter = (idx: number) => {
		reader.switchChapter(idx)
		sidebar.close()
	}
	const goBookmark = (bm: Bookmark) => {
		reader.loadChapter(bm.chapterIndex, bm.sentenceIndex)
		bookmark.highlight(bm.chapterIndex, bm.sentenceIndex)
		sidebar.close()
	}

	onLoad((options) => {
		const bookId = parseInt(options['bookId'] as string)
		reader.init(bookId)
		bookmark.init(bookId, () => content.value)
		bookmark.loadKeys()
	})

	// 退出时保存最终阅读位置
	onUnload(() => {
		reader.saveProgress()
	})
</script>

<style lang="scss">
	.page {
		flex: 1;
		background-color: #faf6ef;
	}
</style>
